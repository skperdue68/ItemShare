# ItemShare site settings. Copy to Database/.env and edit; nothing here is
# committed. Every value has a default, so the site starts without this file on a
# local root/no-password MariaDB - but a real deployment should set all of the
# "required now" values below.
#
# Values marked LATER can stay blank: the feature they belong to is skipped with a
# reason in the log, and can be switched on by adding them and restarting.

# ---------------------------------------------------------------- MariaDB
# The server ItemShare talks to. It never reads MARIADB_DATABASE, so the
# GuildSync schema on the same server can never be touched.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=itemshare
MARIADB_PASSWORD=

# ItemShare's own database. Created on first run, along with every table and
# migration. The account above needs CREATE on this name for that first run.
ITEMSHARE_DATABASE=itemshare

# ---------------------------------------------------------------- the site
PORT=3000

# The public address people will use. It builds the sign-in redirect URIs and the
# "Open your list" link in request emails. No trailing slash.
BASE_URL=http://localhost:3000

# Any long random string; it signs the session cookie, so changing it signs
# everyone out. Make one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# How long a sign-in lasts, in days. Sessions live in MariaDB, so a restart does
# not sign anyone out.
SESSION_TTL_DAYS=30

# ---------------------------------------------------------------- sign-in (optional)
# Either provider can be left blank; the other still works on its own. With both
# blank the site accepts uploads anonymously, but no upload is linked to a person -
# so nobody can be emailed about a request either.
#
# Discord: https://discord.com/developers/applications -> OAuth2 -> Redirects
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Google: https://console.cloud.google.com/apis/credentials (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ---------------------------------------------------------------- request email (LATER)
# On Linux the site sends through the mail server the machine already runs
# (`sendmail -t`: postfix, exim, msmtp, opensmtpd...). Nothing is installed by the
# site. Leave email settings blank for now; requests still work and the log says
# the emails were skipped.
#
# When you are ready: install/configure a mail server, set EMAIL_FROM to an address
# it is allowed to send as, restart, and check with
#   echo test | sendmail -t you@example.com
EMAIL_FROM=

# Optional: force a transport. "sendmail" (default when one is found), "resend"
# (HTTP API, needs RESEND_API_KEY) or "none".
# EMAIL_TRANSPORT=sendmail

# Optional: where sendmail lives, if it is somewhere unusual. Blank checks
# /usr/sbin, /usr/lib and /usr/bin.
# SENDMAIL_PATH=/usr/sbin/sendmail

# Only for hosts with no local mail server (Windows during development, or a VPS
# whose port 25 is blocked). Windows has no sendmail, so sending there is skipped
# unless this is set.
RESEND_API_KEY=

# ---------------------------------------------------------------- requests and baskets
# How long a picked item is held before it goes back to being available.
# REQUEST_HOLD_MINUTES=5
# How often lapsed baskets are released, in milliseconds (0 turns the sweep off;
# every query still treats a lapsed hold as free).
# REQUEST_SWEEP_INTERVAL_MS=10000

# ---------------------------------------------------------------- simulator (optional)
# Any long random string. `npm run simulate` sends it in a header so the running
# site will announce simulated activity to open pages. Blank is fine: the data
# still changes, you just see it on the next refresh.
SIMULATE_TOKEN=

# --------------------------------------------------- automatic uploads (optional)
# GuildSync can watch ItemShareSavedVars.lua on the machine that runs the game and
# POST its contents to /ingest whenever ESO saves it, so the site stays current with
# nobody opening the page. Any long random string; the same value goes in GuildSync.
# Blank turns automatic uploads off and /ingest answers 503.
INGEST_TOKEN=

# ---------------------------------------------------------------- item icons (optional)
# Missing icons are retried on a timer, because a blank icon never repairs itself.
# Interval in milliseconds (0 disables the pass) and how many item ids each pass
# may look up on UESP.
# ICON_BACKFILL_INTERVAL_MS=1800000
# ICON_BACKFILL_BATCH=20
