# Copy to .env and fill in. Every value has a default, so the site starts even
# without this file: 127.0.0.1:3306, user root, empty password, database
# itemshare. Set them explicitly for anything other than a local throwaway.
#
# These point at the MariaDB server that already runs
# GuildSync, but ItemShare always uses its own database and never writes into
# the GuildSync schema. MARIADB_DATABASE from the GuildSync .env is deliberately
# ignored here so the two systems cannot be confused for one another.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=itemshare
MARIADB_PASSWORD=

# Dedicated ItemShare database. It is created on first run if the account has
# CREATE privileges, and all ItemShare tables live in it.
ITEMSHARE_DATABASE=itemshare

# Web upload site.
PORT=3000
# Any long random string; used to sign the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Public address of this site, used to build the default redirect URIs.
BASE_URL=http://localhost:3000

# Discord application (https://discord.com/developers/applications).
# Add the redirect URL below under OAuth2 -> Redirects.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Google OAuth client (https://console.cloud.google.com/apis/credentials).
# Add the redirect URL below under "Authorised redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Either provider can be left blank; the other still works on its own.

# Icons: the server retries missing item icons on a timer, because a blank icon
# never repairs itself otherwise. Interval in milliseconds (0 disables the pass)
# and how many item ids each pass may look up on UESP.
# ICON_BACKFILL_INTERVAL_MS=1800000
# ICON_BACKFILL_BATCH=20

# How long a sign-in lasts, in days. Sessions are stored in MariaDB, so a restart no
# longer signs anyone out; Log out in the avatar menu ends it immediately.
SESSION_TTL_DAYS=30

# Simulator: any long random string. `npm run simulate` sends it in a header so the
# running site will announce simulated activity to open pages. Leave it blank and
# the simulator still works - you just see the changes on the next refresh.
SIMULATE_TOKEN=

# Request emails. On Linux the site hands mail to the host's own mail server
# through sendmail (postfix, exim, msmtp, opensmtpd...), so no account or key is
# needed: set EMAIL_FROM to an address that server is allowed to send as, e.g.
# "ItemShare <requests@your-domain.example>". Nothing is installed by the site.
EMAIL_FROM=

# Optional: force a transport. "sendmail" (the default when one is found),
# "resend" (HTTP API, needs RESEND_API_KEY below) or "none".
# EMAIL_TRANSPORT=sendmail

# Optional: where sendmail lives, if it is somewhere unusual. When blank the
# usual locations are checked (/usr/sbin, /usr/lib, /usr/bin).
# SENDMAIL_PATH=/usr/sbin/sendmail

# Only needed when there is no local mail server - Windows development, or a host
# where mail leaves through Resend. With every option blank the site still works
# and the log says the emails were skipped.
RESEND_API_KEY=
